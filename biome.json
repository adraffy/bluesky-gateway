{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"includes": ["**", "!lib", "!out", "!cache", "!test/fixtures", "!bun.lock"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"trailingCommas": "es5",
			"semicolons": "always"
		}
	},
	"linter": {
		"enabled": true,
		"rules": { "preset": "recommended" }
	},
	"assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } }
}
